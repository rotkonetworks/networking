# bird 3.x container for the newdc clab (matches production hosts: cznic-labs bird3 on trixie).
# Used to prove all-BIRD unnumbered eBGP + RFC 5549 interop against the FRR fabric.
FROM debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg iproute2 iputils-ping \
 && install -d /usr/share/keyrings \
 && curl -fsSL https://pkg.labs.nic.cz/gpg -o /usr/share/keyrings/cznic-labs-pkg.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/cznic-labs-pkg.gpg] https://pkg.labs.nic.cz/bird3 trixie main" \
      > /etc/apt/sources.list.d/cznic-labs-bird3.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends bird3 \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && bird --version

# clab keeps the container alive; its `exec:` sets up interfaces then starts bird
# (matches the FRR-node pattern: configure links first, launch the daemon last).
CMD ["sleep", "infinity"]
