[Unit]
Description=BGP Route Optimization Daemon for AS142108
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bgpctl
Group=bgpctl
ExecStart=/usr/local/bin/bgpctl --config /etc/bgpctl/config.toml
Restart=on-failure
RestartSec=10

# security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

# allow network access and raw sockets for icmp probes
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

# environment file for secrets
EnvironmentFile=-/etc/bgpctl/env

[Install]
WantedBy=multi-user.target
